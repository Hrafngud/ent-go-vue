# Native development: match root .env credentials and the dev database port.
DATABASE_URL=postgres://ent_go_vue:replace_with_random_database_password@localhost:55432/ent_go_vue?sslmode=disable
PORT=8080
JWT_SECRET=replace_with_at_least_32_random_characters
# Optional root login; the API creates/updates this account on startup.
# Set both values; password must be 8–72 bytes. Leave both blank to disable.
ROOT_EMAIL=
ROOT_PASSWORD=
# Native development trusts no forwarding headers by default. In a deployment,
# list only your actual proxy peers (e.g. 172.30.90.2/32), separated by commas.
TRUSTED_PROXY_CIDRS=
# Legacy DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME still work when
# DATABASE_URL is unset. DATABASE_URL takes precedence. DB_SSLMODE defaults to disable.
