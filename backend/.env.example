# Native development: match root .env credentials and the dev database port.
DATABASE_URL=postgres://ent_go_vue:replace_with_random_database_password@localhost:55432/ent_go_vue?sslmode=disable
PORT=8080
JWT_SECRET=replace_with_at_least_32_random_characters
# Legacy DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME still work when
# DATABASE_URL is unset. DATABASE_URL takes precedence. DB_SSLMODE defaults to disable.
