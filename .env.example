# Copy to .env, then replace the placeholders. Never commit .env.
POSTGRES_DB=ent_go_vue
POSTGRES_USER=ent_go_vue
POSTGRES_PASSWORD=replace_with_random_database_password
# Keep credentials in this URL consistent with POSTGRES_* above.
# Percent-encode special characters in the URL username/password.
DATABASE_URL=postgres://ent_go_vue:replace_with_random_database_password@postgres:5432/ent_go_vue?sslmode=disable
JWT_SECRET=replace_with_at_least_32_random_characters
# Optional root login. Set both values to provision/update this account at startup.
# Password must be 8–72 bytes. Leave both blank to disable provisioning.
ROOT_EMAIL=
ROOT_PASSWORD=
# Backend port is internal; only HTTP_PORT is published by the base Compose file.
BACKEND_PORT=8080
HTTP_PORT=18080
# Comma-separated numeric CIDRs of the outer proxy peers as seen by app Nginx.
# Empty trusts nobody. For a host-local edge this is often the Docker bridge
# gateway /32; confirm the peer before configuring it. Never trust the whole subnet.
TRUSTED_EDGE_CIDRS=
# Keep Nginx's fixed address inside APP_SUBNET and outside APP_IP_RANGE.
# Only this /32 is trusted by the API. Change all three together if the subnet
# overlaps an existing host network; automatic addresses use APP_IP_RANGE.
APP_SUBNET=172.30.90.0/24
APP_IP_RANGE=172.30.90.128/25
NGINX_INTERNAL_IP=172.30.90.2
# Used only with docker-compose.dev.yml for native development.
POSTGRES_PORT=55432

# Per-container resource ceilings. CPUs may be fractional; memory accepts m/g units.
# Swap is disabled by setting the memory+swap ceiling equal to the memory ceiling.
POSTGRES_CPUS=1.0
POSTGRES_MEMORY_LIMIT=1g
POSTGRES_PIDS_LIMIT=256
BACKEND_CPUS=1.0
BACKEND_MEMORY_LIMIT=512m
BACKEND_PIDS_LIMIT=128
FRONTEND_CPUS=0.5
FRONTEND_MEMORY_LIMIT=128m
FRONTEND_PIDS_LIMIT=64
NGINX_CPUS=0.5
NGINX_MEMORY_LIMIT=128m
NGINX_PIDS_LIMIT=64
MIGRATE_CPUS=0.5
MIGRATE_MEMORY_LIMIT=256m
MIGRATE_PIDS_LIMIT=64
