# Install in the VPS-wide Nginx after obtaining the certificate. Replace the
# hostname, certificate paths, and application port for this deployment.
server {
    listen 80;
    listen [::]:80;
    server_name app.example.com;
    server_tokens off;

    # Certbot webroot: /var/www/letsencrypt. Keep this available for renewal.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }
    location / {
        return 308 https://app.example.com$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name app.example.com;
    server_tokens off;
    ssl_certificate /etc/letsencrypt/live/app.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.example.com/privkey.pem;

    # Initial host-only rollout. Assign an owner and monitor for one day, then
    # increase max-age after HTTPS/renewal checks pass. Subdomains/preload require
    # a separate inventory and explicit domain-owner decision.
    add_header Strict-Transport-Security "max-age=86400" always;
    proxy_hide_header Strict-Transport-Security;

    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Host app.example.com;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_cache off;
    }
}
